<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>muse_dash_test</RootNamespace>
    <AssemblyName>muse-dash-custom-chart</AssemblyName>
    <Deterministic>true</Deterministic>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- C# 11부터 정적 메서드 그룹을 델리게이트로 넘길 때 컴파일러가 캐시합니다. net6.0 기본값인 10에서는
         MainMod.OnUpdate/OnGUI의 FeatureGuard.Run(이름, 메서드) 호출마다 Action이 새로 할당됩니다. -->
    <LangVersion>11.0</LangVersion>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <!-- 게임 설치 경로 (기본값: H:\muse dash hwa) -->
  <PropertyGroup>
    <GamePath Condition="'$(GamePath)' == ''">H:\muse dash hwa</GamePath>
    <ModsDir>$(GamePath)\Mods</ModsDir>
  </PropertyGroup>

  <!-- 개별 DLL을 나열하는 대신 폴더 전체를 와일드카드로 참조 -->
  <ItemGroup>
    <Reference Include="$(GamePath)\MelonLoader\net6\*.dll" Private="false" />
    <Reference Include="$(GamePath)\MelonLoader\Il2CppAssemblies\*.dll" Private="false" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Resources\tag_icon.png" />
  </ItemGroup>

  <!-- 빌드 후 산출 DLL을 게임 Mods 폴더로 항상 자동 배포 -->
  <Target Name="DeployToMods" AfterTargets="Build">
    <MakeDir Directories="$(ModsDir)" Condition="!Exists('$(ModsDir)')" />
    <!-- 성공 메시지는 실제로 복사된 파일이 있을 때만 찍습니다. ContinueOnError로 빌드는 계속되므로 여기서 갈라집니다. -->
    <Copy SourceFiles="$(TargetPath)"
          DestinationFolder="$(ModsDir)"
          OverwriteReadOnlyFiles="true"
          ContinueOnError="WarnAndContinue">
      <Output TaskParameter="CopiedFiles" ItemName="DeployedFiles" />
    </Copy>
    <Message Condition="'@(DeployedFiles)' != ''" Importance="high" Text="================================================================================" />
    <Message Condition="'@(DeployedFiles)' != ''" Importance="high" Text="[AutoDeploy] Successfully deployed '$(TargetFileName)' -> '$(ModsDir)'" />
    <Message Condition="'@(DeployedFiles)' != ''" Importance="high" Text="================================================================================" />
    <Warning Condition="'@(DeployedFiles)' == ''" Text="[AutoDeploy] 배포 실패: '$(TargetFileName)'을(를) '$(ModsDir)'에 복사하지 못했습니다. 게임이 이 DLL을 잡고 있지 않은지, 폴더 쓰기 권한이 있는지 확인하세요." />
  </Target>
</Project>

