<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>muse_dash_test.LogicTests</RootNamespace>
    <AssemblyName>muse dash test.LogicTests</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!--
    모드 DLL은 net6 + Il2CppAssemblies 참조라 게임 밖에서 로드할 수 없습니다.
    그래서 ProjectReference 대신 순수 로직 소스만 링크해서 함께 컴파일합니다.
    (같은 어셈블리로 빌드되므로 BmsChart/BmsNote의 internal setter도 그대로 사용 가능)
  -->
  <ItemGroup>
    <Compile Include="..\muse dash test\Bms\*.cs" Link="UnderTest\%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
